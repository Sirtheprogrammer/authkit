# AuthKit Environment Variables Reference
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080
ENV=development

# Database Configuration (sqlite, postgres, mysql, mongodb)
DB_TYPE=sqlite
DB_FILE=./authkit.db
# DATABASE_URL=postgres://user:password@localhost:5432/authkit?sslmode=disable
# DATABASE_URL=root:password@tcp(localhost:3306)/authkit?parseTime=true
# DATABASE_URL=mongodb://localhost:27017/authkit

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_ISSUER=authkit
JWT_SECRET=super-secret-key-at-least-32-chars-long
REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# Firebase Auth Integration
FIREBASE_PROJECT_ID=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# Email Configuration (mock, smtp, resend)
EMAIL_PROVIDER=mock
EMAIL_FROM=auth@authkit.local
EMAIL_FROM_NAME="AuthKit"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# Resend Settings (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Model Context Protocol (AI Server)
MCP_ENABLED=true
MCP_AUTH_TOKEN=
